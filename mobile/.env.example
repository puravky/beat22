# Copy this file to .env and set your backend's URL.
# Local dev (web target only - localhost doesn't resolve from a phone/emulator):
# EXPO_PUBLIC_API_URL=http://localhost:4000/api
#
# Local dev on a physical device / emulator - use your machine's LAN IP:
# EXPO_PUBLIC_API_URL=http://192.168.1.23:4000/api
#
# Deployed backend:
# EXPO_PUBLIC_API_URL=https://your-backend.onrender.com/api
EXPO_PUBLIC_API_URL=http://localhost:4000/api
